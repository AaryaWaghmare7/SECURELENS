ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://securelens:REPLACE_ME@127.0.0.1:55432/securelens
JWT_SECRET=
LOCAL_POSTGRES_PASSWORD=
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
SESSION_MINUTES=120
STORAGE_ROOT=.local/storage
IMAGE_RETENTION_DAYS=7
AUTH_RATE_LIMIT=20
STORAGE_CLEANUP_INTERVAL_SECONDS=3600
# Production: FRONTEND_ORIGINS=[] permits backend-first deployment. Later add the
# exact public HTTPS frontend origin. Lists accept JSON arrays or comma-separated
# strings. Secure cookies, PostgreSQL, explicit TRUSTED_HOSTS and an absolute
# persistent STORAGE_ROOT are required. See docs/deployment.md.
